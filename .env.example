# Huntress local configuration.
# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
HUNTRESS_DATA_DIR=.huntress
HUNTRESS_LOG_LEVEL=INFO
HUNTRESS_MODE=lab
# lab | bounty | shadow
HUNTRESS_OPERATOR=local-operator
# Optional path to a TOML config file (default: config/defaults.toml).
# HUNTRESS_CONFIG_FILE=config/defaults.toml

# Signing key for sealed scope documents. If unset, Huntress creates
# .huntress/signing.key with mode 0600 on first use. Set explicitly in
# production and keep it outside the repository.
# HUNTRESS_SIGNING_KEY=change-me-32-bytes-minimum
# HUNTRESS_SIGNING_KEY_FILE=/run/secrets/huntress-signing-key

# ---------------------------------------------------------------------------
# Model provider (default: local LM Studio, OpenAI-compatible)
# ---------------------------------------------------------------------------
HUNTRESS_MODEL_PROVIDER=openai_compatible
HUNTRESS_MODEL_ID=local-model
HUNTRESS_MODEL_BASE_URL=http://127.0.0.1:1234/v1
HUNTRESS_MODEL_API_KEY=lm-studio
HUNTRESS_MODEL_API_KEY_ENV=OPENAI_API_KEY
HUNTRESS_MODEL_TEMPERATURE=0.0
HUNTRESS_MODEL_MAX_TOKENS=2048
HUNTRESS_MODEL_TIMEOUT_SECONDS=120
HUNTRESS_MODEL_MAX_TURNS=4
HUNTRESS_MODEL_TOTAL_TOKEN_LIMIT=24000
HUNTRESS_MODEL_INPUT_COST_PER_MILLION=0.0
HUNTRESS_MODEL_OUTPUT_COST_PER_MILLION=0.0

# Other providers: anthropic | openai | bedrock | ollama | litellm
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AWS_REGION=us-east-1
# OLLAMA_HOST=http://127.0.0.1:11434
# LITELLM_API_BASE=

# ---------------------------------------------------------------------------
# Exegol MCP (verified against exegol-mcp 1.0.2)
# ---------------------------------------------------------------------------
# auto: use Exegol for Exegol profiles when reachable; fake only in lab mode.
HUNTRESS_EXEGOL_BACKEND=auto
HUNTRESS_EXEGOL_URL=http://127.0.0.1:2187/mcp
# exegol-mcp --print-config prints the bearer token. Store it here, not in code.
HUNTRESS_EXEGOL_TOKEN=
HUNTRESS_EXEGOL_CONTAINER=pentest
HUNTRESS_EXEGOL_TIMEOUT_SECONDS=300
HUNTRESS_EXEGOL_MAX_OUTPUT_BYTES=1048576
# Refuse non-loopback/non-private MCP endpoints unless explicitly allowed.
HUNTRESS_EXEGOL_ALLOW_REMOTE=false

# ---------------------------------------------------------------------------
# Limits (defence in depth; also persisted per engagement)
# ---------------------------------------------------------------------------
HUNTRESS_MAX_ACTIONS_PER_ENGAGEMENT=200
HUNTRESS_MAX_MODEL_CALLS_PER_ENGAGEMENT=50
HUNTRESS_MAX_TOKENS_PER_ENGAGEMENT=500000
HUNTRESS_MAX_COST_USD_PER_ENGAGEMENT=5.0
HUNTRESS_MAX_WALL_CLOCK_SECONDS=7200
HUNTRESS_MAX_REQUESTS_PER_HOST_PER_MINUTE=30
HUNTRESS_MAX_REQUESTS_PER_ENGAGEMENT_PER_MINUTE=60
HUNTRESS_MAX_CONCURRENCY=2
HUNTRESS_APPROVAL_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Evidence and reasoning
# ---------------------------------------------------------------------------
HUNTRESS_EVIDENCE_MAX_ARTIFACT_BYTES=10485760
HUNTRESS_EVIDENCE_RETENTION_DAYS=90
HUNTRESS_REASONING_ENABLED=false
HUNTRESS_REASONING_MAX_CONTEXT_CHARS=120000
HUNTRESS_REASONING_CONTEXT_EXCERPT_CHARS=1200
HUNTRESS_REASONING_MAX_EVIDENCE_ITEMS=40

# ---------------------------------------------------------------------------
# Local lab target
# ---------------------------------------------------------------------------
HUNTRESS_LAB_HOST=127.0.0.1
HUNTRESS_LAB_PORT=8000
